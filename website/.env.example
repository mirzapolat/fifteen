# All optional. Copy to .env on the server (~/docker/apps/fifteen-website/.env) only if needed.

# Repository whose latest release provides the Mac DMG.
GITHUB_REPO=mirzapolat/fifteen

# A read-only token raises the GitHub API limit from 60 to 5000 requests/hour.
# Not needed: the server caches the latest release for 5 minutes.
GITHUB_TOKEN=
