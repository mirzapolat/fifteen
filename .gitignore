*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/configuration/
*.xcworkspace/xcshareddata/swiftpm/configuration/
IDEWorkspaceChecks.plist

# The Xcode project is generated from project.yml by `xcodegen generate`.
# It's committed so the repo opens in Xcode without extra tools.
# To treat it as a pure build artifact instead, uncomment:
# Fifteen.xcodeproj/

